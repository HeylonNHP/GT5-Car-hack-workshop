<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:GT5_Car_hack_workshop.Models"
        x:Class="GT5_Car_hack_workshop.TuningShopWindow"
        Title="Tuning Shop"
        Width="1000"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="14" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Text="Pick the car whose parts you want to borrow, choose a category, then install one or many parts onto the current car. Borrowing another car's parts is the point of this window. Installing a part writes its code and sets the game's ownership bit for that part's tier, so the Tuning Shop and the car's Settings screen treat it as bought and fitted. Tyres are not installable here. Everything happens in the save held in memory - use Save only or Save and encrypt on the main window to write it to disk."/>

        <!-- Which car the parts come from, and which car they are fitted to. -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0"
                       Text="Parts from car"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <AutoCompleteBox Grid.Column="1"
                             x:Name="SourceCarBox"
                             Height="24"
                             HorizontalAlignment="Stretch"
                             PlaceholderText="Search a car to borrow parts from..."
                             MaxDropDownHeight="300"/>
            <TextBlock Grid.Column="2"
                       x:Name="InstallTargetText"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource HexFieldBrush}"/>
        </Grid>

        <!-- Narrow the list to one field. "All installable parts" is the default. -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,10,0,0">
            <TextBlock Grid.Column="0"
                       Text="Category"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1"
                      x:Name="CategoryBox"
                      Width="280"
                      Height="24"
                      HorizontalAlignment="Left"
                      SelectionChanged="CategoryBox_SelectionChanged"/>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                BorderBrush="{DynamicResource GroupBorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                Padding="4">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="150,*,80,*" Margin="6,4,6,4">
                    <TextBlock Grid.Column="0" Text="Category" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="Part" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="Code" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="State on the current car" FontWeight="Bold"/>
                </Grid>
                <ListBox Grid.Row="1"
                         x:Name="PartList"
                         SelectionMode="Multiple"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="6,2"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:TuningPartRow">
                            <Grid ColumnDefinitions="150,*,80,*">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding CategoryLabel}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TierName}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Hex}"
                                           FontFamily="monospace"
                                           Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding FittedText}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- One line of status: what the list holds, or whatever just happened. -->
        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   TextWrapping="Wrap"
                   MaxLines="2"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,12,0,0"
                   VerticalAlignment="Center"
                   Text="Opening the parts catalogue..."/>

        <Grid Grid.Row="5" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0"
                    x:Name="InstallSelectedButton"
                    Content="Install selected"
                    Width="130"
                    Height="30"
                    FontWeight="Bold"
                    Background="#C0FFFF"
                    Classes="pastel"
                    Click="InstallSelectedButton_Click"/>
            <Button Grid.Column="1"
                    x:Name="InstallAllButton"
                    Content="Install all shown"
                    Width="140"
                    Height="30"
                    Margin="8,0,0,0"
                    Click="InstallAllButton_Click"/>
            <Button Grid.Column="3"
                    x:Name="CloseButton"
                    Content="Close"
                    Width="90"
                    Height="30"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click"
                    IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
