<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="470"
        x:Class="GT5_Car_hack_workshop.TransmissionEditorWindow"
        Title="Transmission editor"
        Width="500" Height="470"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#FF808080">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Gear Ratios -->
        <StackPanel Grid.Column="0" Spacing="4">
            <!-- Gear 1 -->
            <Grid ColumnDefinitions="100,*">
                <TextBlock Text="1st Gear" Grid.Column="0" Foreground="#FF80FFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox1" Grid.Column="1" Background="#FF004040" Foreground="#FF80FFFF" FontWeight="Bold"/>
            </Grid>

            <!-- Gear 2 -->
            <Grid ColumnDefinitions="100,*">
                <TextBlock Text="2nd Gear" Grid.Column="0" Foreground="#FF80FFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox2" Grid.Column="1" Background="#FF004040" Foreground="#FF80FFFF" FontWeight="Bold"/>
            </Grid>

            <!-- Gear 3 -->
            <Grid ColumnDefinitions="100,*">
                <TextBlock Text="3rd Gear" Grid.Column="0" Foreground="#FF80FFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox3" Grid.Column="1" Background="#FF004040" Foreground="#FF80FFFF" FontWeight="Bold"/>
            </Grid>

            <!-- Gear 4 -->
            <Grid ColumnDefinitions="100,*">
                <TextBlock Text="4th Gear" Grid.Column="0" Foreground="#FF80FFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox4" Grid.Column="1" Background="#FF004040" Foreground="#FF80FFFF" FontWeight="Bold"/>
            </Grid>

            <!-- Gear 5 -->
            <Grid ColumnDefinitions="100,*">
                <TextBlock Text="5th Gear" Grid.Column="0" Foreground="#FF80FFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox5" Grid.Column="1" Background="#FF004040" Foreground="#FF80FFFF" FontWeight="Bold"/>
            </Grid>

            <!-- Gear 6 -->
            <Grid ColumnDefinitions="100,*">
                <TextBlock Text="6th Gear" Grid.Column="0" Foreground="#FF80FFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox6" Grid.Column="1" Background="#FF004040" Foreground="#FF80FFFF" FontWeight="Bold"/>
            </Grid>

            <!-- Gear 7 -->
            <Grid ColumnDefinitions="100,*">
                <TextBlock Text="7th Gear" Grid.Column="0" Foreground="#FF80FFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox7" Grid.Column="1" Background="#FF004040" Foreground="#FF80FFFF" FontWeight="Bold"/>
            </Grid>

            <!-- Gear 8 -->
            <Grid ColumnDefinitions="100,*">
                <TextBlock Text="8th Gear" Grid.Column="0" Foreground="#FF80FFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox8" Grid.Column="1" Background="#FF004040" Foreground="#FF80FFFF" FontWeight="Bold"/>
            </Grid>

            <!-- Gear 9 -->
            <Grid ColumnDefinitions="100,*">
                <TextBlock Text="9th Gear" Grid.Column="0" Foreground="#FF80FFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox9" Grid.Column="1" Background="#FF004040" Foreground="#FF80FFFF" FontWeight="Bold"/>
            </Grid>

            <!-- Gear 10 -->
            <Grid ColumnDefinitions="100,*">
                <TextBlock Text="10th Gear" Grid.Column="0" Foreground="#FF80FFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox10" Grid.Column="1" Background="#FF004040" Foreground="#FF80FFFF" FontWeight="Bold"/>
            </Grid>

            <!-- Gear 11 -->
            <Grid ColumnDefinitions="100,*">
                <TextBlock Text="11th Gear" Grid.Column="0" Foreground="#FF80FFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox11" Grid.Column="1" Background="#FF004040" Foreground="#FF80FFFF" FontWeight="Bold"/>
            </Grid>

            <!-- Final Gear -->
            <Grid ColumnDefinitions="100,*">
                <TextBlock Text="Final Gear" Grid.Column="0" Foreground="#FF80FFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox12" Grid.Column="1" Background="#FF004040" Foreground="#FF80FFFF" FontWeight="Bold"/>
            </Grid>

            <!-- Okay Button -->
            <Button x:Name="OkayButton" Content="Okay" Background="#C0FFFF" Height="35" Margin="0,10,0,0" Click="OkayButtonClick"/>
        </StackPanel>

        <!-- Right Panel - Calculate Speed -->
        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="5,0,0,0">
            <StackPanel Margin="10" Spacing="10">
                <TextBlock Text="Calculate speed" FontWeight="Bold" FontSize="13"/>

                <StackPanel Spacing="5">
                    <TextBlock Text="Original max speed" Foreground="#FF80FFFF"/>
                    <TextBox x:Name="TextBox13" Text="0" Background="#FF004040" Foreground="#FF80FFFF" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Current max speed" Foreground="#FF80FFFF"/>
                    <TextBox x:Name="TextBox14" Text="???" Background="#FF004040" Foreground="#FF80FFFF" FontWeight="Bold" IsReadOnly="True"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
