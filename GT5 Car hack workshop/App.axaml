<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GT5_Car_hack_workshop.App"
             RequestedThemeVariant="Dark">
             <!-- The UI is designed around a dark background, so the theme variant is
                  pinned to Dark to keep the tuned colour palette readable no matter
                  what theme the user's system is set to. -->

    <Application.Resources>
        <!--
          Semantic colour palette
          =======================
          The coloured labels carry meaning (documented in the "Key" box on Page 1), so
          the hue of each colour is preserved - only lightness/saturation has been
          tuned so that every colour is comfortably readable on the dark background
          (WCAG AA contrast of 4.5:1 or better for text):

          HexFieldBrush     - "Hex only"    - fields expecting hexadecimal values     (was Blue,        2.4:1 -> 6.3:1)
          DecimalFieldBrush - "Decimal only"- fields expecting decimal values         (was Red,         5.3:1 -> 6.6:1)
          LegendBrush       - the "Key" legend box                                    (unchanged Magenta, 6.7:1)
          PartRemovalBrush  - visual part-removal checkboxes                          (was DarkViolet,  3.2:1 -> 8.5:1)
          SambaBrush        - "Samba-like performance" easter-egg control             (unchanged Lime,   15:1)
          SlamCarBrush      - "Slam car" action text on its cyan button               (was OrangeRed,   3.1:1 -> 4.8:1)
          OpenEditorBrush   - background of the red "Open" editor buttons             (was Red, white text 4.0:1 -> 5.0:1)
          GroupBorderBrush  - group box outlines, dimmed so labels stand out          (was Gray #666666, retuned for the group box fill below)
        -->
        <SolidColorBrush x:Key="HexFieldBrush" Color="#4D88FF"/>
        <SolidColorBrush x:Key="DecimalFieldBrush" Color="#FF5252"/>
        <SolidColorBrush x:Key="LegendBrush" Color="Magenta"/>
        <SolidColorBrush x:Key="PartRemovalBrush" Color="#C58AFF"/>
        <SolidColorBrush x:Key="SambaBrush" Color="Lime"/>
        <SolidColorBrush x:Key="SlamCarBrush" Color="#C04000"/>
        <SolidColorBrush x:Key="OpenEditorBrush" Color="#D32F2F"/>
        <SolidColorBrush x:Key="GroupBorderBrush" Color="#3E4854"/>
        <!-- Dark text used on the light pastel buttons, which keep white theme text otherwise -->
        <SolidColorBrush x:Key="PastelButtonForegroundBrush" Color="#141414"/>

        <!--
          Surface palette
          ===============
          Fluent's dark theme paints the window, the tab bodies and the group
          boxes in pure black, so the whole UI reads as one flat black sheet -
          group boxes have nothing to stand out against and the input fields
          disappear into them. A three-step palette replaces that flatness:

          #14181D  application canvas            (was #000000)
          #1F262E  group box fill, one step up   (was transparent)
          #0D1115  text/combo fields, one down   (was #66000000 over black)

          Every accent colour above keeps at least 4.8:1 contrast against the
          lightest of these, so the Hex/Decimal/Legend colour coding still reads.
        -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#14181D"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1F262E"/>

        <!-- The TextBox and ComboBox templates draw their own surfaces from these
             Fluent resources, so override them to match the palette above. -->
        <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#14181D"/>
        <SolidColorBrush x:Key="TextControlBackground" Color="#0D1115"/>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#161D25"/>
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#131A21"/>
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#4A5663"/>
        <SolidColorBrush x:Key="ComboBoxBackground" Color="#0D1115"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#161D25"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#131A21"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Pastel button colour-coding (pink/green/lavender/yellow/cyan/orange): dark text
             for readability on the light backgrounds (9.5:1 - 16:1 contrast) -->
        <Style Selector="Button.pastel">
            <Setter Property="Foreground" Value="{DynamicResource PastelButtonForegroundBrush}"/>
        </Style>
    </Application.Styles>
</Application>