<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <RootNamespace>GT5_Car_hack_workshop</RootNamespace>
        <AssemblyName>GT5 Car hack workshop</AssemblyName>
        <StartupObject>GT5_Car_hack_workshop.Program</StartupObject>
        <ApplicationIcon>GT5 Car hack workshop.ico</ApplicationIcon>
        <LangVersion>latest</LangVersion>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

        <!-- Assembly Information -->
        <Version>2.6.0.0</Version>
        <AssemblyVersion>2.6.0.0</AssemblyVersion>
        <FileVersion>2.6.0.0</FileVersion>
        <Company>Nuclear Heylon Productions (HeylonNHP)</Company>
        <Product>GT5 Car hack workshop 2</Product>
        <Title>GT5 Car hack workshop 2</Title>
        <Copyright>Copyright © NHP 2025</Copyright>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.2" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22" />
        <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.1.26425.128" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-rc.1.26425.128" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\Resources.resources" />
        <EmbeddedResource Include="Resources\Tranny.resources" />
        <EmbeddedResource Include="Resources\PaintDatabase.tsv" />
    </ItemGroup>

    <!-- The app reads and rewrites partsdatabase.db next to the executable, so it
         must be copied to the output folder and kept up to date there. -->
    <ItemGroup>
        <None Update="partsdatabase.db">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Exclude old Windows Forms files from compilation -->
    <ItemGroup>
        <Compile Remove="Components\FormComponents\SearchableComboBox.cs" />
        <Compile Remove="Components\FormComponents\SearchableComboBox.Designer.cs" />
    </ItemGroup>
</Project>