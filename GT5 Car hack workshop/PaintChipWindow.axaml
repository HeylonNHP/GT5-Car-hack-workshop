<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GT5_Car_hack_workshop.PaintChipWindow"
        Title="Add Paint Chips"
        Width="560"
        Height="470"
        MinWidth="460"
        MinHeight="400"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="14" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Text="Search the paint database for a colour, choose how many chips of that colour to add, then click Add. Chips are written into the save that is open in memory — use Save only or Save and encrypt on the main window when you are ready to write them to disk."/>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,12,0,0">
            <TextBlock Grid.Column="0"
                       Text="Paint colour"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <AutoCompleteBox Grid.Column="1"
                             x:Name="PaintSearchBox"
                             Height="24"
                             HorizontalAlignment="Stretch"
                             PlaceholderText="Search by name, maker or hex id..."
                             MaxDropDownHeight="300"/>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,10,0,0">
            <TextBlock Grid.Column="0"
                       Text="Quantity"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <NumericUpDown Grid.Column="1"
                           x:Name="QuantityBox"
                           Width="130"
                           Minimum="1"
                           Maximum="1000"
                           Increment="1"
                           FormatString="0"
                           Value="1"/>
            <Button Grid.Column="2"
                    x:Name="AddButton"
                    Content="Add"
                    Width="90"
                    Height="30"
                    Margin="10,0,0,0"
                    FontWeight="Bold"
                    Background="#C0FFFF"
                    Classes="pastel"
                    Click="AddButton_Click"/>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                BorderBrush="{DynamicResource GroupBorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                Padding="8">
            <ScrollViewer>
                <TextBlock x:Name="StatusText"
                           TextWrapping="Wrap"
                           Text="Opening the save's item database..."/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,12,0,0">
            <Button x:Name="CloseButton"
                    Content="Close"
                    Width="90"
                    Height="30"
                    Click="CloseButton_Click"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
