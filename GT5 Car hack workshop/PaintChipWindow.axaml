<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:GT5_Car_hack_workshop.Models"
        x:Class="GT5_Car_hack_workshop.PaintChipWindow"
        Title="Add Paint Chips"
        Width="860"
        Height="580"
        MinWidth="660"
        MinHeight="460"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="14" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Text="Search the paint database for a colour, choose how many chips of that colour to add, then click Add. Chips are written into the save that is open in memory — use Save only or Save and encrypt on the main window when you are ready to write them to disk."/>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,12,0,0">
            <TextBlock Grid.Column="0"
                       Text="Paint colour"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <AutoCompleteBox Grid.Column="1"
                             x:Name="PaintSearchBox"
                             Height="24"
                             HorizontalAlignment="Stretch"
                             PlaceholderText="Search by name, maker or hex id..."
                             MaxDropDownHeight="300"/>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,10,0,0">
            <TextBlock Grid.Column="0"
                       Text="Quantity"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <NumericUpDown Grid.Column="1"
                           x:Name="QuantityBox"
                           Width="130"
                           Minimum="1"
                           Maximum="1000"
                           Increment="1"
                           FormatString="0"
                           Value="1"/>
            <Button Grid.Column="2"
                    x:Name="AddButton"
                    Content="Add"
                    Width="90"
                    Height="30"
                    Margin="10,0,0,0"
                    FontWeight="Bold"
                    Background="#C0FFFF"
                    Classes="pastel"
                    Click="AddButton_Click"/>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="3*,2*" ColumnSpacing="10" Margin="0,12,0,0">

            <!-- Colours the save currently owns -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource GroupBorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    Padding="8">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0"
                               x:Name="OwnedSummaryText"
                               Text="Owned paint chips"
                               FontWeight="Bold"/>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="6,6,6,4">
                        <TextBlock Grid.Column="0" Text="Colour" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1"
                                   Text="Quantity"
                                   FontWeight="Bold"
                                   MinWidth="60"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <ListBox Grid.Row="2"
                             x:Name="OwnedChipsList"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:OwnedPaintChipRow">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Display}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding QuantityText}"
                                               MinWidth="60"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- What has been done in this dialog -->
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource GroupBorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    Padding="8">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Activity" FontWeight="Bold"/>
                    <ScrollViewer Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock x:Name="StatusText"
                                   TextWrapping="Wrap"
                                   Text="Opening the save's item database..."/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,12,0,0">
            <Button x:Name="CloseButton"
                    Content="Close"
                    Width="90"
                    Height="30"
                    Click="CloseButton_Click"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
