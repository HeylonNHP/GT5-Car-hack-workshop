<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:GT5_Car_hack_workshop.Models"
        xmlns:local="using:GT5_Car_hack_workshop"
        x:Class="GT5_Car_hack_workshop.PaintChipWindow"
        Title="Manage Paint Chips"
        Width="700"
        Height="540"
        MinWidth="560"
        MinHeight="420"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="14" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Text="Search the paint database for a colour, choose how many chips of that colour to add, then click Add. Right-click a colour in the list below to add more of it or to delete chips from it, using the Quantity above as the amount. Changes go into the save that is open in memory — use Save only or Save and encrypt on the main window when you are ready to write them to disk."/>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0"
                       Text="Paint colour"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ContentControl Grid.Column="1"
                            Width="20" Height="20"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Content="{Binding #PaintSearchBox.SelectedItem}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="local:PaintEntry">
                        <Border Width="20" Height="20"
                                CornerRadius="3" BorderThickness="1"
                                BorderBrush="#40000000"
                                Background="{Binding SwatchBrush}"/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <AutoCompleteBox Grid.Column="2"
                             x:Name="PaintSearchBox"
                             Height="24"
                             HorizontalAlignment="Stretch"
                             PlaceholderText="Search by name, maker or hex id..."
                             MaxDropDownHeight="300">
                <AutoCompleteBox.ItemTemplate>
                    <DataTemplate x:DataType="local:PaintEntry">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0"
                                    Width="16" Height="16"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    CornerRadius="3" BorderThickness="1"
                                    BorderBrush="#40000000"
                                    Background="{Binding SwatchBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Display}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>
            <Button Grid.Column="3"
                    x:Name="PaintBrowseButton"
                    Content="Browse…"
                    Width="66"
                    Height="24"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Click="PaintBrowseButton_Click"/>
            <ComboBox Grid.Column="4"
                      x:Name="PaintFinishBox"
                      Width="130"
                      Height="24"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      SelectionChanged="PaintFinishBox_SelectionChanged"/>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,10,0,0">
            <TextBlock Grid.Column="0"
                       Text="Quantity"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <NumericUpDown Grid.Column="1"
                           x:Name="QuantityBox"
                           Width="130"
                           Minimum="1"
                           Maximum="1000"
                           Increment="1"
                           FormatString="0"
                           Value="1"/>
            <Button Grid.Column="2"
                    x:Name="AddButton"
                    Content="Add"
                    Width="90"
                    Height="30"
                    Margin="10,0,0,0"
                    FontWeight="Bold"
                    Background="#C0FFFF"
                    Classes="pastel"
                    Click="AddButton_Click"/>
        </Grid>

        <!-- Colours the save currently owns -->
        <Border Grid.Row="3"
                Margin="0,12,0,0"
                BorderBrush="{DynamicResource GroupBorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    Padding="8">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0"
                               Text="Owned paint chips"
                               FontWeight="Bold"/>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="6,6,6,4">
                        <TextBlock Grid.Column="0" Text="Colour" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1"
                                   Text="Quantity"
                                   FontWeight="Bold"
                                   MinWidth="60"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <ListBox Grid.Row="2"
                             x:Name="OwnedChipsList"
                             Background="Transparent"
                             BorderThickness="0"
                             DoubleTapped="OwnedChipsList_DoubleTapped"
                             ContextRequested="OwnedChipsList_ContextRequested"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <!-- Headers carrying counts are set when the menu is about to open. -->
                            <ContextMenu>
                                <MenuItem x:Name="AddOneMenuItem" Header="Add 1 chip" Click="AddOneMenuItem_Click"/>
                                <MenuItem x:Name="AddMoreMenuItem" Header="Add more chips" Click="AddMoreMenuItem_Click"/>
                                <Separator/>
                                <MenuItem x:Name="DeleteOneMenuItem" Header="Delete 1 chip" Click="DeleteOneMenuItem_Click"/>
                                <MenuItem x:Name="DeleteColourMenuItem" Header="Delete this colour…" Click="DeleteColourMenuItem_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:OwnedPaintChipRow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0"
                                            Width="14" Height="14"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="3" BorderThickness="1"
                                            BorderBrush="#40000000"
                                            Background="{Binding SwatchBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Display}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding QuantityText}"
                                               MinWidth="60"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

        <!-- One line of status: the owned totals, or whatever just happened. -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0"
                       x:Name="StatusText"
                       TextWrapping="Wrap"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Text="Opening the save's item database..."/>
            <Button Grid.Column="1"
                    x:Name="CloseButton"
                    Content="Close"
                    Width="90"
                    Height="30"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click"
                    IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
