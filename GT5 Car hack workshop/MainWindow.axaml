<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
        x:Class="GT5_Car_hack_workshop.MainWindow"
        Title="GT5 Car hack workshop 2.6 (For GT5 2.14). Created by HeylonNHP"
        Width="1200" Height="900"
        CanResize="False"
        FontSize="10">

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Spacing="4">
            <!-- File and Settings Group -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="4">
                <StackPanel Spacing="4">
                    <TextBlock Text="Before and after you start hacking" FontWeight="Bold"/>

                    <TextBlock Text="GT5.0 file location:"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="TextBox1" Grid.Column="0" Margin="0,0,4,0" Height="22"/>
                        <Button x:Name="Button1" Content="Browse" Grid.Column="1" Background="#FFFFE0C0" Height="22" Click="Button1_Click"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="PSN name" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TextBox2" Grid.Column="1" Height="22"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,Auto">
                        <Button x:Name="LoadButton" Content="Load data" Grid.Column="0" Background="#FFC0C0" Margin="0,0,4,0" Height="22" Click="LoadButton_Click"/>
                        <Button x:Name="SaveAndEncryptButton" Content="Save and encrypt" Grid.Column="1" Background="#C0FFC0" Margin="0,0,4,0" Height="22" Click="SaveAndEncrypt_Click"/>
                        <Button x:Name="Button5" Content="Save only" Grid.Column="2" Background="#C0C0FF" Margin="0,0,4,0" Height="22" Click="Button5_Click"/>
                        <Button x:Name="Button22" Content="About" Grid.Column="3" Background="#FFFFC0" Height="22" Click="Button22_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Parts Database TabControl -->
            <TabControl Height="380">
                <TabItem Header="Parts Database">
                    <ScrollViewer>
                        <StackPanel Spacing="3" Margin="4">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="Engine" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="EngineCodeComboBox" Grid.Column="1" Height="22" SelectionChanged="EngineCodeComboBox_SelectionChanged"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="Drivetrain" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="DrivetrainCodeComboBox" Grid.Column="1" Height="22" SelectionChanged="DrivetrainCodeComboBox_SelectionChanged"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="Chassis" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="ChassisCodeComboBox" Grid.Column="1" Height="22" SelectionChanged="ChassisCodeComboBox_SelectionChanged"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="Transmission" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="TransmissionCodeComboBox" Grid.Column="1" Height="22" SelectionChanged="TransmissionCodeComboBox_SelectionChanged"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="Suspension" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="SuspensionCodeComboBox" Grid.Column="1" Height="22" SelectionChanged="SuspensionCodeComboBox_SelectionChanged"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="Body" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="BodyCodeComboBox" Grid.Column="1" Height="22" SelectionChanged="BodyCodeComboBox_SelectionChanged"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="LSD" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="LsdCodeComboBox" Grid.Column="1" Height="22" SelectionChanged="LsdCodeComboBox_SelectionChanged"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="Horn" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="HornCodeComboBox" Grid.Column="1" Height="22" SelectionChanged="HornCodeComboBox_SelectionChanged"/>
                            </Grid>

                            <Button x:Name="Button12" Content="Add current car to parts database" Background="#C0FFFF" Height="22" Click="Button12_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Misc.">
                    <StackPanel Spacing="3" Margin="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Custom Samba like performance:" Grid.Column="0" VerticalAlignment="Center"/>
                            <Button x:Name="Button13" Content="Open" Grid.Column="1" Background="Red" Foreground="White" Height="22" Click="Button13_Click"/>
                        </Grid>
                        <Button x:Name="Button15" Content="Borrow glitch (Steal car)" FontWeight="Bold" FontStyle="Italic" Height="22" Click="Button15_Click"/>
                        <Button x:Name="Button18" Content="Get 4.2 billion credits ($$$)" Height="22" Click="Button18_Click"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>

        <!-- Right Panel -->
        <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BorderBrush="Gray" BorderThickness="1" Padding="4" Margin="4,0,0,0">
            <StackPanel Spacing="2">
                <TextBlock Text="Basic hacks" FontWeight="Bold"/>

                <TabControl>
                    <TabItem Header="Page 1">
                        <ScrollViewer>
                            <StackPanel Spacing="6" Margin="3">
                                <!-- Current Car Label -->
                                <TextBlock x:Name="Label7" Text="??Car??" FontStyle="Italic"/>

                                <!-- Key Legend and Downforce/Torque side-by-side -->
                                <Grid ColumnDefinitions="Auto,8,*,8,*">
                                    <!-- Key Legend -->
                                    <Border Grid.Column="0" BorderBrush="Magenta" BorderThickness="1" Padding="2">
                                        <StackPanel>
                                            <TextBlock Text="Key" Foreground="Magenta" FontWeight="Bold" FontSize="9"/>
                                            <TextBlock Text="Hex only" Foreground="Blue" FontWeight="Bold" FontSize="9"/>
                                            <TextBlock Text="Decimal only" Foreground="Red" FontWeight="Bold" FontSize="9"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Downforce -->
                                    <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="2">
                                        <StackPanel>
                                            <TextBlock Text="Downforce" FontWeight="Bold"/>
                                            <Grid ColumnDefinitions="Auto,*,Auto,*">
                                                <TextBlock Text="Aero" Grid.Column="0" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="AeroFrontTextBox" Grid.Column="1" Width="60" Height="20" Margin="0,0,6,0"/>
                                                <TextBlock Text=":" Grid.Column="2" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="AeroRearTextBox" Grid.Column="3" Width="60" Height="20"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Torque -->
                                    <Border Grid.Column="4" BorderBrush="Gray" BorderThickness="1" Padding="2">
                                        <StackPanel>
                                            <TextBlock Text="Torque" FontWeight="Bold"/>
                                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">
                                                <TextBlock Text="Tq. Split" Grid.Column="0" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="TorqueSplitTextBox" Grid.Column="1" Width="60" Height="20" Margin="0,0,4,0" TextChanged="TorqueSplitTextBox_TextChanged"/>
                                                <TextBlock Text=":" Grid.Column="2" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="TextBox5" Grid.Column="3" Width="60" Height="20" IsReadOnly="True" Margin="0,0,4,0"/>
                                                <Button x:Name="Button8" Content="?" Grid.Column="4" Height="20" Click="Button8_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Transmission -->
                                <Border BorderBrush="Gray" BorderThickness="1" Padding="2">
                                    <StackPanel>
                                        <TextBlock Text="Transmission" FontWeight="Bold"/>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="Transmission editor" Grid.Column="0" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button x:Name="Button11" Content="Open" Grid.Column="1" Background="Red" Foreground="White" HorizontalAlignment="Left" Height="22" Click="Button11_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Visual Mods and Car Parts side-by-side -->
                                <Grid ColumnDefinitions="*,8,*">
                                    <!-- Visual mods -->
                                    <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Visual mods" FontWeight="Bold"/>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <TextBlock Text="Remove spoiler" Grid.Column="0" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="RemoveSpoilerCodeTextBox" Grid.Column="1" Width="60" Height="20" Margin="0,0,4,0"/>
                                                <Button x:Name="Button10" Content="?" Grid.Column="2" Margin="0,0,4,0" Height="20" Click="Button10_Click"/>
                                                <Button x:Name="Button23" Content="?" Grid.Column="3" Height="20" Click="Button23_Click"/>
                                            </Grid>
                                            <CheckBox x:Name="RemoveHoodCheckBox" Content="Remove hood" Foreground="DarkViolet" FontWeight="Bold" Margin="0,1"/>
                                            <CheckBox x:Name="RemoveFrontBumperCheckBox" Content="Remove front bumper" Foreground="DarkViolet" FontWeight="Bold" Margin="0,1"/>
                                            <CheckBox x:Name="RemoveRearBumperCheckBox" Content="Remove rear bumper" Foreground="DarkViolet" FontWeight="Bold" Margin="0,1"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Car parts -->
                                    <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Car parts" FontWeight="Bold"/>
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                                <TextBlock Text="Car body" Grid.Row="0" Grid.Column="0" Foreground="Blue" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="CarBodyCodeTextBox" Grid.Row="0" Grid.Column="1" Height="20" Margin="0,1"/>

                                                <TextBlock Text="Suspension" Grid.Row="1" Grid.Column="0" Foreground="Blue" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="SuspensionCodeTextBox" Grid.Row="1" Grid.Column="1" Height="20" Margin="0,1"/>

                                                <TextBlock Text="LSD" Grid.Row="2" Grid.Column="0" Foreground="Blue" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="LsdCodeTextBox" Grid.Row="2" Grid.Column="1" Height="20" Margin="0,1"/>

                                                <TextBlock Text="Horn" Grid.Row="3" Grid.Column="0" Foreground="Blue" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="HornCodeTextBox" Grid.Row="3" Grid.Column="1" Height="20" Margin="0,1"/>

                                                <TextBlock Text="Engine" Grid.Row="4" Grid.Column="0" Foreground="Blue" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="3" Margin="0,1">
                                                    <TextBox x:Name="EngineCodeTextBox" Width="100" Height="20"/>
                                                    <Button x:Name="Button7" Content="?" Height="20" Click="Button7_Click"/>
                                                </StackPanel>

                                                <TextBlock Text="Transmission" Grid.Row="5" Grid.Column="0" Foreground="Blue" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="TransmissionCodeTextBox" Grid.Row="5" Grid.Column="1" Height="20" Margin="0,1"/>

                                                <TextBlock Text="Chassis" Grid.Row="6" Grid.Column="0" Foreground="Blue" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="ChassisCodeTextBox" Grid.Row="6" Grid.Column="1" Height="20" Margin="0,1"/>

                                                <TextBlock Text="Drivetrain" Grid.Row="7" Grid.Column="0" Foreground="Blue" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="DrivetrainCodeTextBox" Grid.Row="7" Grid.Column="1" Height="20" Margin="0,1"/>
                                            </Grid>
                                            <Button x:Name="Button6" Content="Make 4WD" Background="#C0FFFF" HorizontalAlignment="Center" Height="22" Click="Button6_Click"/>
                                            <Button x:Name="Button4" Content="Force torque split editor install" Background="#FFFFC0" Height="22" Click="Button4_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Performance Multipliers and Reset Protection side-by-side -->
                                <Grid ColumnDefinitions="*,8,*">
                                    <!-- Performance multipliers -->
                                    <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Performance multipliers" FontWeight="Bold"/>
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Text="Turbo" Grid.Column="0" Foreground="Blue" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="TurboModifierTextBox" Grid.Column="1" Height="20" Margin="0,0,4,0"/>
                                                <Button x:Name="Button16" Content="?" Grid.Column="2" Height="20" Click="Button16_Click"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Text="Exhaust" Grid.Column="0" Foreground="Blue" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="ExhauseMultiplierTextBox" Grid.Column="1" Height="20"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Text="Horsepower" Grid.Column="0" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="HorsepowerMultiplierText" Grid.Column="1" Height="20"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <CheckBox x:Name="SambaLikePerformanceCheckbox" Content="Samba-like performance" Foreground="Lime" FontWeight="Bold" FontStyle="Italic" Margin="0,1"/>
                                                <Button x:Name="Button17" Content="?" Height="20" Click="Button17_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Reset protection -->
                                    <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Reset protection" FontWeight="Bold"/>
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <CheckBox x:Name="AddLucaBytesCheckBox" Content="Add LUCA bytes before FF block" Margin="0,1"/>
                                                <Button x:Name="Button14" Content="?" Height="20" Click="Button14_Click"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <CheckBox x:Name="Add74ByteCheckBox" Content="Add 74 byte before FF block" IsChecked="True" Margin="0,1"/>
                                                <Button x:Name="Button9" Content="?" Height="20" Click="Button9_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Page 2">
                        <ScrollViewer>
                            <StackPanel Spacing="6" Margin="3">
                                <!-- Suspension -->
                                <Border BorderBrush="Gray" BorderThickness="1" Padding="2">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Suspension" FontWeight="Bold"/>
                                        <Grid ColumnDefinitions="Auto,*,Auto,*">
                                            <TextBlock Text="Suspension height" Grid.Column="0" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox x:Name="SuspensionHeightFrontTextBox" Grid.Column="1" Width="70" Height="20" Margin="0,0,4,0"/>
                                            <TextBlock Text=":" Grid.Column="2" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox x:Name="SuspensionHeightRearTextBox" Grid.Column="3" Width="70" Height="20"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto,*">
                                            <TextBlock Text="Spring rate" Grid.Column="0" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox x:Name="SpringRateFrontTextBox" Grid.Column="1" Width="70" Height="20" Margin="0,0,4,0"/>
                                            <TextBlock Text=":" Grid.Column="2" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox x:Name="SpringRateRearTextBox" Grid.Column="3" Width="70" Height="20"/>
                                        </Grid>
                                        <Button x:Name="Button19" Content="Slam car" Background="#C0FFFF" Foreground="OrangeRed" FontWeight="Bold" HorizontalAlignment="Center" Height="22" Click="Button19_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Paint -->
                                <Border BorderBrush="Gray" BorderThickness="1" Padding="2">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Paint" FontWeight="Bold"/>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="Body" Grid.Column="0" Foreground="Blue" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox x:Name="BodyPaintTextBox" Grid.Column="1" Height="20"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="Wheels" Grid.Column="0" Foreground="Blue" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox x:Name="WheelsPaintTextBox" Grid.Column="1" Height="20"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Other -->
                                <Border BorderBrush="Gray" BorderThickness="1" Padding="2">
                                    <StackPanel>
                                        <TextBlock Text="Other" FontWeight="Bold"/>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="Grip" Grid.Column="0" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox x:Name="GripTextBox" Grid.Column="1" Width="70" Height="20" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Weight hack -->
                                <Border BorderBrush="Gray" BorderThickness="1" Padding="2">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Weight hack" FontWeight="Bold"/>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="Weight multiplier" Grid.Column="0" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox x:Name="WeightMultiplierTextBox" Grid.Column="1" Height="20"/>
                                        </Grid>
                                        <CheckBox x:Name="CheckBox4" Content="Install stage 3 weight reduction" Margin="0,1"/>
                                    </StackPanel>
                                </Border>

                                <!-- Experimental -->
                                <Border BorderBrush="Gray" BorderThickness="1" Padding="2">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Under development (EXPERIMENTAL)" FontWeight="Bold"/>
                                        <TextBlock Text="Transmission"/>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Button x:Name="Button20" Content="Install" Background="#C0FFC0" Height="22" Click="Button20_Click"/>
                                            <Button x:Name="Button21" Content="Uninstall" Background="#FFC0C0" Height="22" Click="Button21_Click"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Button x:Name="BadOilBtn" Content="Set bad oil" Background="#FFC0C0" Height="22" Click="BadOilBtn_Click"/>
                                            <Button x:Name="GoodOilBtn" Content="Set good oil" Background="#C0FFC0" Height="22" Click="GoodOilBtn_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>