<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:GT5_Car_hack_workshop"
        mc:Ignorable="d"
        d:DesignWidth="1200" d:DesignHeight="680"
        x:Class="GT5_Car_hack_workshop.MainWindow"
        Title="GT5 Car hack workshop 2.7 (For GT5 2.14). Created by HeylonNHP"
        Width="1200" Height="680" MinWidth="1000" MinHeight="520"
        CanResize="True"
        FontSize="10"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel. A Grid rather than a StackPanel: a StackPanel measures its children
             with unlimited height, so the ScrollViewer inside the parts tab would report its
             full content height and never scroll - and the window would size to it. -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" RowDefinitions="Auto,*" RowSpacing="4">
            <!-- File and Settings Group -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="4">
                <StackPanel Spacing="4">
                    <TextBlock Text="Before and after you start hacking" FontWeight="Bold"/>

                    <TextBlock Text="GT5.0 file location:"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="TextBox1" Grid.Column="0" Margin="0,0,4,0" Height="22"/>
                        <Button x:Name="Button1" Content="Browse" Grid.Column="1" Background="#FFFFE0C0" Classes="pastel" Height="27" Click="Button1_Click"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="PSN name" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="PsnNameTextBox" Grid.Column="1" Height="22" IsReadOnly="True"
                                 PlaceholderText="shown once a save is loaded"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,Auto">
                        <Button x:Name="LoadButton" Content="Load data" Grid.Column="0" Background="#FFC0C0" Classes="pastel" Margin="0,0,4,0" Height="27" Click="LoadButton_Click"/>
                        <Button x:Name="SaveAndEncryptButton" Content="Save and encrypt" Grid.Column="1" Background="#C0FFC0" Classes="pastel" Margin="0,0,4,0" Height="27" Click="SaveAndEncrypt_Click"/>
                        <Button x:Name="Button5" Content="Save only" Grid.Column="2" Background="#C0C0FF" Classes="pastel" Margin="0,0,4,0" Height="27" Click="Button5_Click"/>
                        <Button x:Name="Button22" Content="About" Grid.Column="3" Background="#FFFFC0" Classes="pastel" Height="27" Click="Button22_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Parts Database TabControl. It fills whatever height is left (no fixed height),
                 so a taller window shows more of the part rows and the list scrolls only when
                 the rows still do not fit. -->
            <TabControl Grid.Row="1">
                <TabItem Header="Parts Database">
                    <ScrollViewer>
                        <StackPanel Spacing="3" Margin="4">
                            <!-- Known tunes: the save file's own preset list (pt_gt5_*), each one a full set
                                 of parts for one car. Picking one and pressing "Apply tune" fills in every
                                 part drop-down that the tune defines. -->
                            <Border BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="3">
                                <Grid ColumnDefinitions="64,*,Auto" RowDefinitions="Auto,Auto">
                                    <TextBlock Text="Known tune" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <AutoCompleteBox x:Name="PresetSearchBox" Grid.Row="0" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                     PlaceholderText="Search a saved tune (pt_gt5_...)" MaxDropDownHeight="240" IsTextCompletionEnabled="False"/>
                                    <Button x:Name="ApplyPresetButton" Grid.Row="0" Grid.Column="2" Content="Apply tune" Background="#C0FFFF" Classes="pastel" Height="27" Margin="4,0,0,0"/>
                                    <TextBlock x:Name="PresetInfoText" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource HexFieldBrush}"/>
                                </Grid>
                            </Border>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Engine" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="EngineCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="EngineHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Drivetrain" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="DrivetrainCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="DrivetrainHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Chassis" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="ChassisCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="ChassisHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Transmission" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="TransmissionCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="TransmissionHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Suspension" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="SuspensionCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="SuspensionHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Body" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="BodyCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                          IsEditable="True" IsTextSearchEnabled="False" PlaceholderText="Select..."/>
                                <TextBlock x:Name="BodyHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="LSD" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="LsdCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="LsdHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Horn" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="HornCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                          IsEditable="True" IsTextSearchEnabled="False" PlaceholderText="Select..."/>
                                <TextBlock x:Name="HornHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Turbo" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="TurboCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="TurboHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Exhaust" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="ExhaustCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="ExhaustHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Weight" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="WeightCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="WeightHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>

                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Brake" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="BrakeCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="BrakeHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Brake controller" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="BrakeControllerCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="BrakeControllerHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Displacement" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="DisplacementCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="DisplacementHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Computer (ECU)" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="ComputerCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="ComputerHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="NA tune" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="NatuneCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="NatuneHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Flywheel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="FlywheelCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="FlywheelHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Clutch" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="ClutchCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="ClutchHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Propeller shaft" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="PropellerShaftCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="PropellerShaftHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Intercooler" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="IntercoolerCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="IntercoolerHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Supercharger" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="SuperchargerCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="SuperchargerHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Intake manifold" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="IntakeManifoldCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="IntakeManifoldHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Exhaust manifold" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="ExhaustManifoldCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="ExhaustManifoldHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Catalyst" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="CatalystCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="CatalystHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="Air cleaner" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="AirCleanerCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="AirCleanerHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,48">
                                <TextBlock Text="NOS" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="NosCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch"
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="NosHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>

                            <!-- Tyres. A tyre is not a two-byte part code but an 8-byte grade key whose last
                                 byte is the slot, so the box holds the grade's name and the label beside it
                                 shows the whole key. Every grade fits every car, hence the plain names. The
                                 hex column is wider than the part rows': the full key is 8 bytes long. -->
                            <TextBlock Text="Tyres" Margin="0,8,0,0" FontWeight="Bold"/>
                            <Grid ColumnDefinitions="108,*,170">
                                <TextBlock Text="Front tyres" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="FrontTyreCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch" ToolTip.Tip="Any slot from 0 to 255. The 15 named grades are 0 to 14."
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="FrontTyreHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>
                            <Grid ColumnDefinitions="108,*,170">
                                <TextBlock Text="Rear tyres" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <AutoCompleteBox x:Name="RearTyreCodeComboBox" Grid.Column="1" Height="22" HorizontalAlignment="Stretch" ToolTip.Tip="Any slot from 0 to 255. The 15 named grades are 0 to 14."
                                                 PlaceholderText="Filter, pick, or type a code..." MaxDropDownHeight="320" IsTextCompletionEnabled="False"/>
                                <TextBlock x:Name="RearTyreHexLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                           Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold"/>
                            </Grid>

                            <Button x:Name="Button12" Content="Add current car to parts database" Background="#C0FFFF" Classes="pastel" Height="27" Click="Button12_Click"/>
                            <TextBlock x:Name="PartsCatalogueInfoText" TextWrapping="Wrap" Foreground="{DynamicResource HexFieldBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Misc.">
                    <StackPanel Spacing="3" Margin="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Custom Samba like performance:" Grid.Column="0" VerticalAlignment="Center"/>
                            <Button x:Name="Button13" Content="Open" Grid.Column="1" Background="{DynamicResource OpenEditorBrush}" Foreground="White" Height="27" Click="Button13_Click"/>
                        </Grid>
                        <Button x:Name="Button15" Content="Borrow glitch (Steal car)" FontWeight="Bold" FontStyle="Italic" Height="27" Click="Button15_Click"/>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Credits:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" x:Name="CreditsTextBox" Height="27"
                                     PlaceholderText="Enter an amount (0 - 4,294,967,295)"
                                     ToolTip.Tip="Type the number of credits you want, then use Save only or Save and encrypt."
                                     TextChanged="CreditsTextBox_TextChanged"/>
                        </Grid>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Right Panel -->
        <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="4" Margin="4,0,0,0">
            <Grid RowDefinitions="Auto,*" RowSpacing="2">
                <TextBlock Grid.Row="0" Text="Basic hacks" FontWeight="Bold"/>

                <TabControl Grid.Row="1">
                    <TabItem Header="Page 1">
                        <ScrollViewer>
                            <StackPanel Spacing="6" Margin="3">
                                <!-- Current Car Label -->
                                <TextBlock x:Name="Label7" Text="??Car??" FontStyle="Italic"/>

                                <!-- Key Legend and Downforce/Torque side-by-side -->
                                <Grid ColumnDefinitions="Auto,8,*,8,*">
                                    <!-- Key Legend -->
                                    <Border Grid.Column="0" BorderBrush="{DynamicResource LegendBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="2">
                                        <StackPanel>
                                            <TextBlock Text="Key" Foreground="{DynamicResource LegendBrush}" FontWeight="Bold" FontSize="9"/>
                                            <TextBlock Text="Hex only" Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold" FontSize="9"/>
                                            <TextBlock Text="Decimal only" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" FontSize="9"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Downforce -->
                                    <Border Grid.Column="2" BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="2">
                                        <StackPanel>
                                            <TextBlock Text="Downforce" FontWeight="Bold"/>
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" HorizontalAlignment="Left">
                                                <TextBlock Text="Aero" Grid.Column="0" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="AeroFrontTextBox" Grid.Column="1" Width="60" Height="20" Margin="0,0,6,0"/>
                                                <TextBlock Text=":" Grid.Column="2" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="AeroRearTextBox" Grid.Column="3" Width="60" Height="20"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Torque -->
                                    <Border Grid.Column="4" BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="2">
                                        <StackPanel>
                                            <TextBlock Text="Torque" FontWeight="Bold"/>
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" HorizontalAlignment="Left">
                                                <TextBlock Text="Tq. Split" Grid.Column="0" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="TorqueSplitTextBox" Grid.Column="1" Width="60" Height="20" Margin="0,0,4,0" TextChanged="TorqueSplitTextBox_TextChanged"/>
                                                <TextBlock Text=":" Grid.Column="2" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="TextBox5" Grid.Column="3" Width="60" Height="20" IsReadOnly="True" Margin="0,0,4,0"/>
                                                <Button x:Name="Button8" Content="?" Grid.Column="4" Height="25" Click="Button8_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Transmission -->
                                <Border BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="2">
                                    <StackPanel>
                                        <TextBlock Text="Transmission" FontWeight="Bold"/>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="Transmission editor" Grid.Column="0" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button x:Name="Button11" Content="Open" Grid.Column="1" Background="{DynamicResource OpenEditorBrush}" Foreground="White" HorizontalAlignment="Left" Height="27" Click="Button11_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Visual Mods and Car Parts side-by-side -->
                                <Grid ColumnDefinitions="*,8,*">
                                    <!-- Visual mods -->
                                    <Border Grid.Column="0" BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Visual mods" FontWeight="Bold"/>
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" HorizontalAlignment="Left">
                                                <TextBlock Text="Remove spoiler" Grid.Column="0" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="RemoveSpoilerCodeTextBox" Grid.Column="1" Width="60" Height="20" Margin="0,0,4,0"/>
                                                <Button x:Name="Button10" Content="?" Grid.Column="2" Margin="0,0,4,0" Height="25" Click="Button10_Click"/>
                                                <Button x:Name="Button23" Content="?" Grid.Column="3" Height="25" Click="Button23_Click"/>
                                            </Grid>
                                            <CheckBox x:Name="RemoveHoodCheckBox" Content="Remove hood" Foreground="{DynamicResource PartRemovalBrush}" FontWeight="Bold" Margin="0,1"/>
                                            <CheckBox x:Name="RemoveFrontBumperCheckBox" Content="Remove front bumper" Foreground="{DynamicResource PartRemovalBrush}" FontWeight="Bold" Margin="0,1"/>
                                            <CheckBox x:Name="RemoveRearBumperCheckBox" Content="Remove rear bumper" Foreground="{DynamicResource PartRemovalBrush}" FontWeight="Bold" Margin="0,1"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Car parts -->
                                    <Border Grid.Column="2" BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Car parts" FontWeight="Bold"/>
                                            <Button x:Name="Button7" Content="Engine hex help ?" HorizontalAlignment="Left" Height="25" Click="Button7_Click"/>
                                            <Button x:Name="Button6" Content="Make 4WD" Background="#C0FFFF" Classes="pastel" HorizontalAlignment="Center" Height="27" Click="Button6_Click"/>
                                            <Button x:Name="Button4" Content="Force torque split editor install" Background="#FFFFC0" Classes="pastel" Height="27" Click="Button4_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Performance Multipliers and Reset Protection side-by-side -->
                                <Grid ColumnDefinitions="*,8,*">
                                    <!-- Performance multipliers -->
                                    <Border Grid.Column="0" BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Performance multipliers" FontWeight="Bold"/>
                                            <!-- Turbo and Exhaust are now part-id drop-downs in the Parts Database tab. -->
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Text="Horsepower" Grid.Column="0" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="HorsepowerMultiplierText" Grid.Column="1" Height="20"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <CheckBox x:Name="SambaLikePerformanceCheckbox" Content="Samba-like performance" Foreground="{DynamicResource SambaBrush}" FontWeight="Bold" FontStyle="Italic" Margin="0,1"/>
                                                <Button x:Name="Button17" Content="?" Height="25" Click="Button17_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Reset protection -->
                                    <Border Grid.Column="2" BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Reset protection" FontWeight="Bold"/>
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <CheckBox x:Name="AddLucaBytesCheckBox" Content="Add LUCA bytes before FF block" Margin="0,1"/>
                                                <Button x:Name="Button14" Content="?" Height="25" Click="Button14_Click"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <CheckBox x:Name="Add74ByteCheckBox" Content="Add 74 byte before FF block" IsChecked="True" Margin="0,1"/>
                                                <Button x:Name="Button9" Content="?" Height="25" Click="Button9_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Page 2">
                        <ScrollViewer>
                            <StackPanel Spacing="6" Margin="3">
                                <!-- Suspension -->
                                <Border BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="2">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Suspension" FontWeight="Bold"/>
                                        <!-- Both rows share one grid, so the columns line up; every value
                                             column is Auto so the text sits at the left, next to its label. -->
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Suspension height" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="SuspensionHeightFrontTextBox" Width="70" Height="20" Margin="0,0,4,0"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text=":" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="SuspensionHeightRearTextBox" Width="70" Height="20"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Spring rate" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="SpringRateFrontTextBox" Width="70" Height="20" Margin="0,0,4,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text=":" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="SpringRateRearTextBox" Width="70" Height="20"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Camber" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="CamberFrontTextBox" Width="70" Height="20" Margin="0,0,4,0" ToolTip.Tip="Accepts 0 to 255. The game's own camber setting is 0 to 20."/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text=":" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox Grid.Row="2" Grid.Column="3" x:Name="CamberRearTextBox" Width="70" Height="20" ToolTip.Tip="Accepts 0 to 255. The game's own camber setting is 0 to 20."/>
                                        </Grid>
                                        <Button x:Name="Button19" Content="Slam car" Background="#C0FFFF" Classes="pastel" Foreground="{DynamicResource SlamCarBrush}" FontWeight="Bold" HorizontalAlignment="Left" Height="27" Click="Button19_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Handling -->
                                <Border BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="2">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Handling" FontWeight="Bold"/>
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Brake balance" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="BrakeBalanceFrontTextBox" Width="70" Height="20" Margin="0,0,4,0" ToolTip.Tip="Accepts 0 to 255. The game's default is 5."/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text=":" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="BrakeBalanceRearTextBox" Width="70" Height="20" ToolTip.Tip="Accepts 0 to 255. The game's default is 5."/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Power limiter" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="PowerLimiterTextBox" Width="70" Height="20" HorizontalAlignment="Left" ToolTip.Tip="Accepts 0 to 65535. Stored as percent x 10, so 1000 is 100%."/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Paint -->
                                <Border BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="2">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Paint" FontWeight="Bold"/>
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,78">
                                            <TextBlock Text="Body" Grid.Column="0" Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ContentControl Grid.Column="1" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"
                                                            Content="{Binding #BodyPaintAutoCompleteBox.SelectedItem}">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate x:DataType="local:PaintEntry">
                                                        <Border Width="18" Height="18" CornerRadius="3" BorderThickness="1"
                                                                BorderBrush="#40000000" Background="{Binding SwatchBrush}"/>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                            <AutoCompleteBox x:Name="BodyPaintAutoCompleteBox" Grid.Column="2" Height="22" Margin="0,0,4,0" HorizontalAlignment="Stretch" Watermark="Search paint..." MaxDropDownHeight="280" SelectionChanged="BodyPaintAutoCompleteBox_SelectionChanged">
                                                <AutoCompleteBox.ItemTemplate>
                                                    <DataTemplate x:DataType="local:PaintEntry">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <Border Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                    CornerRadius="3" BorderThickness="1" BorderBrush="#40000000" Background="{Binding SwatchBrush}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Display}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </AutoCompleteBox.ItemTemplate>
                                            </AutoCompleteBox>
                                            <Button x:Name="BodyBrowseButton" Grid.Column="3" Content="Browse…" Width="66" Height="22" Margin="4,0,0,0"
                                                    VerticalAlignment="Center" Click="BodyBrowseButton_Click"/>
                                            <ComboBox x:Name="BodyFinishComboBox" Grid.Column="4" Width="112" Height="22" Margin="4,0,0,0" HorizontalAlignment="Left"
                                                      VerticalAlignment="Center" SelectionChanged="BodyFinishComboBox_SelectionChanged"/>
                                            <TextBox x:Name="BodyPaintTextBox" Grid.Column="5" Height="20" TextChanged="BodyPaintTextBox_TextChanged"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,78">
                                            <TextBlock Text="Wheels" Grid.Column="0" Foreground="{DynamicResource HexFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ContentControl Grid.Column="1" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"
                                                            Content="{Binding #WheelsPaintAutoCompleteBox.SelectedItem}">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate x:DataType="local:PaintEntry">
                                                        <Border Width="18" Height="18" CornerRadius="3" BorderThickness="1"
                                                                BorderBrush="#40000000" Background="{Binding SwatchBrush}"/>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                            <AutoCompleteBox x:Name="WheelsPaintAutoCompleteBox" Grid.Column="2" Height="22" Margin="0,0,4,0" HorizontalAlignment="Stretch" Watermark="Search paint..." MaxDropDownHeight="280" SelectionChanged="WheelsPaintAutoCompleteBox_SelectionChanged">
                                                <AutoCompleteBox.ItemTemplate>
                                                    <DataTemplate x:DataType="local:PaintEntry">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <Border Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                    CornerRadius="3" BorderThickness="1" BorderBrush="#40000000" Background="{Binding SwatchBrush}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Display}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </AutoCompleteBox.ItemTemplate>
                                            </AutoCompleteBox>
                                            <Button x:Name="WheelsBrowseButton" Grid.Column="3" Content="Browse…" Width="66" Height="22" Margin="4,0,0,0"
                                                    VerticalAlignment="Center" Click="WheelsBrowseButton_Click"/>
                                            <ComboBox x:Name="WheelsFinishComboBox" Grid.Column="4" Width="112" Height="22" Margin="4,0,0,0" HorizontalAlignment="Left"
                                                      VerticalAlignment="Center" SelectionChanged="WheelsFinishComboBox_SelectionChanged"/>
                                            <TextBox x:Name="WheelsPaintTextBox" Grid.Column="5" Height="20" TextChanged="WheelsPaintTextBox_TextChanged"/>
                                        </Grid>
                                        <Button x:Name="ManagePaintChipsButton" Content="Manage paint chips…" Height="26" Margin="0,2,0,0" HorizontalAlignment="Stretch" Click="ManagePaintChipsButton_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Other -->
                                <Border BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="2">
                                    <StackPanel>
                                        <TextBlock Text="Other" FontWeight="Bold"/>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="Grip" Grid.Column="0" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox x:Name="GripTextBox" Grid.Column="1" Width="70" Height="20" HorizontalAlignment="Left"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                                            <TextBlock Text="Driven km" Grid.Column="0" Foreground="{DynamicResource DecimalFieldBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox x:Name="OdometerTextBox" Grid.Column="1" Width="100" Height="20" HorizontalAlignment="Left" PlaceholderText="km"/>
                                            <Button x:Name="Button24" Content="?" Grid.Column="2" Height="25" Click="Button24_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Weight hack -->
                                <Border BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="2">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Weight hack" FontWeight="Bold"/>
                                        <!-- Weight is now a part-id drop-down in the Parts Database tab. -->
                                        <CheckBox x:Name="CheckBox4" Content="Install stage 3 weight reduction" Margin="0,1"/>
                                    </StackPanel>
                                </Border>

                                <!-- Experimental -->
                                <Border BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="2">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Under development (EXPERIMENTAL)" FontWeight="Bold"/>
                                        <TextBlock Text="Transmission"/>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Button x:Name="Button20" Content="Install" Background="#C0FFC0" Classes="pastel" Height="27" Click="Button20_Click"/>
                                            <Button x:Name="Button21" Content="Uninstall" Background="#FFC0C0" Classes="pastel" Height="27" Click="Button21_Click"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Button x:Name="BadOilBtn" Content="Set bad oil" Background="#FFC0C0" Classes="pastel" Height="27" Click="BadOilBtn_Click"/>
                                            <Button x:Name="GoodOilBtn" Content="Set good oil" Background="#C0FFC0" Classes="pastel" Height="27" Click="GoodOilBtn_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Window>